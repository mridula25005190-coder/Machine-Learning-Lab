import os
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from statsmodels.tsa.arima.model import ARIMA

# ----------------------------------------------------
# Create sample dataset if it does not exist
# ----------------------------------------------------
if not os.path.exists("network_traffic.csv"):
    np.random.seed(42)

    timestamps = pd.date_range(
        start="2024-01-01",
        periods=300,
        freq="H"
    )

    traffic = np.random.normal(500, 40, 300)

    # Add artificial DDoS spikes
    traffic[60] = 900
    traffic[120] = 950
    traffic[180] = 1000
    traffic[250] = 920

    df = pd.DataFrame({
        "Timestamp": timestamps,
        "Traffic": traffic
    })

    df.to_csv("network_traffic.csv", index=False)
    print("Sample dataset created successfully.")

# ----------------------------------------------------
# Load Dataset
# ----------------------------------------------------
data = pd.read_csv("network_traffic.csv")

# Convert Timestamp column
data["Timestamp"] = pd.to_datetime(data["Timestamp"])

# Set Timestamp as index
data.set_index("Timestamp", inplace=True)

# Select Traffic column
traffic = data["Traffic"]

# ----------------------------------------------------
# Train-Test Split
# ----------------------------------------------------
train_size = int(len(traffic) * 0.8)

train = traffic[:train_size]
test = traffic[train_size:]

# ----------------------------------------------------
# Build ARIMA Model
# ----------------------------------------------------
model = ARIMA(train, order=(5,1,0))
model_fit = model.fit()

# ----------------------------------------------------
# Forecast
# ----------------------------------------------------
forecast = model_fit.forecast(steps=len(test))

# ----------------------------------------------------
# Plot Results
# ----------------------------------------------------
plt.figure(figsize=(10,5))

plt.plot(test.index, test, label="Actual Traffic")
plt.plot(test.index, forecast, label="Predicted Traffic")

plt.title("DDoS Traffic Prediction using ARIMA")
plt.xlabel("Time")
plt.ylabel("Traffic")
plt.legend()

plt.show()

# ----------------------------------------------------
# Detect DDoS
# ----------------------------------------------------
threshold = 100

print("\nDetection Results:\n")

for actual, predicted in zip(test, forecast):

    if actual > predicted + threshold:
        print(f"Traffic = {actual:.2f} --> Potential DDoS Attack Detected")
    else:
        print(f"Traffic = {actual:.2f} --> Normal Network Traffic")
